# ===== 大模型（通义千问 DashScope）=====
# auto: 有 Key 用 Qwen，无 Key 自动 Mock；qwen: 强制真实；mock: 强制模拟
LLM_MODE=auto
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-plus
QWEN_VL_MODEL=qwen3-vl-plus
LLM_TIMEOUT=90

# ===== 小模型（用户自行训练后接入）=====
# stub: 可运行基线；http: 调用你自己的推理服务
SMALL_MODEL_MODE=stub
VISION_SERVICE_URL=
NLP_KG_SERVICE_URL=
SMALL_MODEL_TIMEOUT=30

# ===== 本地中文文本嵌入模型（服装知识图谱语义边）=====
# 模型文件放在 backend/models/nlp/bge-small-zh-v1.5/
NLP_EMBEDDING_ENABLED=true
NLP_EMBEDDING_MODEL_DIR=models/nlp/bge-small-zh-v1.5
NLP_EMBEDDING_MODEL_FILE=model_int8.onnx
NLP_EMBEDDING_MAX_LENGTH=256
NLP_SEMANTIC_TOP_K=3
NLP_SEMANTIC_THRESHOLD=0.55
# 远程推理服务的可选 Bearer Token（留空表示不鉴权；不会写日志）
SMALL_MODEL_TOKEN=
# 远程服务失败时是否自动降级到本地 Stub（推荐 true）
SMALL_MODEL_FALLBACK_TO_STUB=true

# ===== 浏览器自动化 =====
# playwright: 稳定演示（默认）；browser_use: 需自行安装 browser-use
BROWSER_ENGINE=playwright
BROWSER_HEADLESS=true
PLAYWRIGHT_CHANNEL=msedge

# ===== 可选 browser-use 引擎 =====
# 1) 安装：backend/.venv/Scripts/python.exe -m pip install -r requirements-optional.txt
# 2) .env 设置 BROWSER_ENGINE=browser_use 且 DASHSCOPE_API_KEY 非空
# 3) browser-use 需要 LLM 驱动；没有 Key 时不会伪造成功
BROWSER_USE_MODEL=
BROWSER_USE_MAX_STEPS=40
BROWSER_USE_TIMEOUT=240
BROWSER_USE_EXECUTABLE_PATH=
BROWSER_USE_FALLBACK_TO_PLAYWRIGHT=false

# ===== 安全与运行 =====
JWT_SECRET=dev-change-me-please
JWT_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./data/app.db
FRONTEND_DIST=../frontend/dist
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
